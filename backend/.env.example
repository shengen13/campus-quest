# Path to the Firebase Admin SDK service-account JSON downloaded from
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/campus-quest-firebase-admin.json

# Or use a JSON string instead of a file path:
# FIREBASE_SERVICE_ACCOUNT_JSON={...}

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
